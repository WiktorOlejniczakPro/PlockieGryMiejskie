# =====================================================================
#  PGM – Płockie Gry Miejskie · konfiguracja środowiska
#  Skopiuj ten plik jako ".env" i uzupełnij wartości.
#  Pliku .env NIE wrzucaj do repozytorium.
# =====================================================================

# development – szczegółowe błędy na ekranie
# production  – błędy tylko w storage/logs/app.log
APP_ENV=development
APP_DEBUG=true

# Adres aplikacji bez końcowego ukośnika. Zostaw puste, aby wykryć go
# automatycznie (np. http://localhost/pgm/public).
APP_URL=

# --- Baza danych -------------------------------------------------------
# Szybki start w XAMPP: DB_USER=root i puste DB_PASS.
# Zalecane: osobny użytkownik z uprawnieniami tylko do bazy pgm.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=pgm
DB_USER=root
DB_PASS=

# --- Sesje i konta -----------------------------------------------------
# Wylogowanie po tylu minutach bezczynności
SESSION_LIFETIME_MINUTES=120
# Samodzielna rejestracja twórców (konta czekają na zatwierdzenie)
REGISTRATION_ENABLED=false

# TRYB DEMONSTRACYJNY – automatyczne logowanie jednego konta (bez ekranu logowania).
# Wpisz e-mail istniejącego, aktywnego konta, np. AUTO_LOGIN_EMAIL=admin@example.org
# Każdy, kto otworzy stronę, będzie zalogowany na to konto – używaj tylko lokalnie
# lub na pokazie. Przy APP_ENV=production ustawienie jest ignorowane.
AUTO_LOGIN_EMAIL=

# --- Mapa --------------------------------------------------------------
MAP_CENTER_LAT=52.5463
MAP_CENTER_LNG=19.6865
MAP_DEFAULT_ZOOM=15
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
GEOCODER_URL=https://nominatim.openstreetmap.org/search

# --- Pliki -------------------------------------------------------------
UPLOAD_MAX_MB=5
