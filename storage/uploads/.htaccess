# Przesłane pliki NIE mogą być wykonywane ani wydawane bezpośrednio.
# Udostępnia je wyłącznie aplikacja (kontroler sprawdzający uprawnienia).
Require all denied
Options -Indexes -ExecCGI
<IfModule mod_php.c>
  php_flag engine off
</IfModule>
<IfModule mod_php7.c>
  php_flag engine off
</IfModule>
RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .php8 .phar
RemoveType .php .phtml .phar
